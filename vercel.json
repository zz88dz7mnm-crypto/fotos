{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/muro",      "destination": "/index.html" },
    { "source": "/subir",     "destination": "/index.html" },
    { "source": "/revelador", "destination": "/revelador.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
